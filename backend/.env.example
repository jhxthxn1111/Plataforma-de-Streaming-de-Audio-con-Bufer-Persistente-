PORT=3000
FRONTEND_URL=http://localhost:5173
# Reemplaza TU_CONTRASEÑA por la de tu PostgreSQL local (en backend/.env, que Git ignora)
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/musica

# Secreto para firmar los access token (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Secreto distinto al anterior, para firmar las URLs temporales de streaming (mínimo 32 caracteres).
# Se genera igual:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUDIO_SECRET_KEY=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
# En desarrollo (frontend y API en localhost) basta con strict. Si se despliegan en dominios
# distintos (como en Render), usa COOKIE_SAMESITE=none y COOKIE_SECURE=true.
COOKIE_SAMESITE=strict

# Correo (verificación de cuenta y recuperación de contraseña).
# En desarrollo déjalo en console: el enlace aparece en la terminal del backend, no se envía nada.
# En producción (Render bloquea el SMTP del plan gratuito) usa brevo o gmail, ambos con API HTTP.
EMAIL_PROVIDER=console
# Solo con EMAIL_PROVIDER=brevo:
#   BREVO_API_KEY      clave de la API v3 de Brevo (empieza por xkeysib-)
#   MAIL_FROM_EMAIL    remitente verificado en Brevo (Settings > Senders)
#   MAIL_FROM_NAME     nombre visible del remitente (por defecto "Música")
# Solo con EMAIL_PROVIDER=gmail (Gmail API, scope gmail.send):
#   GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET   credenciales OAuth de Google Cloud Console
#   GMAIL_REFRESH_TOKEN                    se obtiene con OAuth Playground
#   MAIL_FROM_EMAIL                        debe ser la cuenta de Gmail autorizada
