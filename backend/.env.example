PORT=3000
FRONTEND_URL=http://localhost:5173
# Reemplaza TU_CONTRASEÑA por la de tu PostgreSQL local (en backend/.env, que Git ignora)
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/musica

# Secreto para firmar los access token (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
# En desarrollo (frontend y API en localhost) basta con strict. Si se despliegan en dominios
# distintos, usa COOKIE_SAMESITE=none y COOKIE_SECURE=true.
COOKIE_SAMESITE=strict
